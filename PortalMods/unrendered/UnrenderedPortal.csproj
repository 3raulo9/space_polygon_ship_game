<Project Sdk="Microsoft.NET.Sdk">

  <!-- THE RIFT, UNRENDERED side: a code mod. One file, glowstone-rift.dll, dropped into the
       game's Mods folder beside the .json mods. The game finds the IGameMod in it and calls it
       from its own loop. The game's code is not changed; one runtime hook (Hooks.cs) wraps the
       moment the finished frame is presented, so Minecraft can be shown at full resolution.

       It compiles against the game project only to see its types. Neither Unrendered.dll nor
       Raylib-cs.dll is shipped with it: the game's own are already loaded. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>glowstone-rift</AssemblyName>
    <RootNamespace>UnrenderedPortal</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Unrendered.csproj" Private="false" />
    <!-- Harmony rides inside the dll as a resource (see Hooks.cs), so the mod stays one file. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.2" GeneratePathProperty="true" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PkgLib_Harmony)\lib\net10.0\0Harmony.dll" LogicalName="0Harmony.dll" />
  </ItemGroup>

  <!-- The finished mod, ready to drop into <UNRENDERED>/Mods/. -->
  <Target Name="PackRift" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)glowstone-rift.dll" DestinationFolder="$(MSBuildProjectDirectory)\out" SkipUnchangedFiles="true" />
  </Target>

</Project>
